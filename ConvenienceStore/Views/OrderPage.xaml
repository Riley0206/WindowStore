<Page
    x:Class="ConvenienceStore.Views.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConvenienceStore.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ConvenienceStore.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:ConvenienceStore.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="#F9F9F9">
    <Page.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Background" Value="#41B4A3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Duration="0" To="#379486" Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" Storyboard.TargetName="buttonBackground"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Duration="0" To="#2e776c" Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" Storyboard.TargetName="buttonBackground"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="buttonBackground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="buttonBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="TextBoxStyle">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Duration="0" To="#E0E0E0" Storyboard.TargetProperty="(TextBox.Background).(SolidColorBrush.Color)" Storyboard.TargetName="textBoxBackground"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="border">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#41B4A3" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="textBoxBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"  >
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}"  IsTabStop="False"  VerticalScrollBarVisibility="Auto">
                                    <TextBlock Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap" Text="{TemplateBinding Text}"  />
                                </ScrollViewer>
                            </Border>
                            <Border  x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="controls:DataGrid" x:Key="DataGridStyle">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#F9F9F9"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="ContentControl">
                        <Setter Property="Background" Value="#28344E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D4D4D4"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="controls:DataGridRow" x:Key="DataGridRowStyle">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Quản lý đơn hàng"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Margin="0,0,0,20"
                   Foreground="#28344E"
                   FontWeight="Bold"/>
        <!-- Filter Panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Foreground="#28344E"/>
            <DatePicker  Date="{Binding StartDateFilter, Mode=TwoWay}"  />
            <TextBlock Text="Đến ngày:" VerticalAlignment="Center"  Foreground="#28344E"/>
            <DatePicker  Date="{Binding EndDateFilter, Mode=TwoWay}"  />
            <TextBox x:Name="SearchBox" Width="200" PlaceholderText="Tìm kiếm..." Style="{StaticResource TextBoxStyle}"  />
            <Button Content="Tìm kiếm đơn hàng" Click="SearchOrdersButton_Click" Style="{StaticResource ButtonStyle}" />
            <Button Content="Tìm kiếm đơn nhập" Click="SearchPurchaseOrdersButton_Click" Style="{StaticResource ButtonStyle}" />
        </StackPanel>
        <!-- Main Content -->
        <muxc:TabView Grid.Row="2">
            <muxc:TabViewItem Header="Đơn hàng bán ra">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" >
                        <controls:DataGrid
                            x:Name="SalesOrdersDataGrid"
                            ItemsSource="{x:Bind ViewModel.DisplayedOrders, Mode=OneWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            GridLinesVisibility="Horizontal"
                            Style="{StaticResource DataGridStyle}"
                             MaxHeight="200"
                            RowStyle="{StaticResource DataGridRowStyle}"
                            SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Mã ĐH" Binding="{Binding OrderID}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Nhân viên" Binding="{Binding Employee.EmployeeName}" Width="auto"/>
                                <controls:DataGridTemplateColumn Header="Ngày bán"  Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding OrderDate, Converter={StaticResource DateTimeConverter}, ConverterParameter='dd/MM/yyyy'}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Tổng tiền"  Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentMethod}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="auto"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </StackPanel>


                    <TextBlock Grid.Row="1" 
                           Text="Chi tiết đơn hàng"  
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Foreground="#28344E"  
                           Margin="0,10,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <controls:DataGrid
                                x:Name="SalesOrderDetailsDataGrid"
                                ItemsSource="{x:Bind ViewModel.SelectedOrderDetails, Mode=OneWay}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                GridLinesVisibility="Horizontal"
                                 Style="{StaticResource DataGridStyle}"
                                RowStyle="{StaticResource DataGridRowStyle}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Mã SP" Binding="{Binding Product.ProductName}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="auto"/>
                                <controls:DataGridTemplateColumn Header="Đơn giá" Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Giảm giá"  Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Discount, Converter={StaticResource CurrencyConverter}}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10" >
                        <TextBlock
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="#28344E"
                            VerticalAlignment="Center">
                            <Run Text="Tổng doanh thu: "/>
                            <Run Text="{x:Bind ViewModel.TotalSales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal"  Spacing="10">
                            <Button Content="Trang trước"
                                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"  Style="{StaticResource ButtonStyle}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#28344E">
                                    <Run Text="Trang "/>
                                    <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/>
                            </TextBlock>

                            <Button Content="Trang sau"
                                    Command="{x:Bind ViewModel.NextPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"  Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Đơn hàng nhập kho">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" >
                        <controls:DataGrid
                            x:Name="PurchaseOrdersDataGrid"
                            ItemsSource="{x:Bind ViewModel.DisplayedPurchaseOrders, Mode=OneWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            GridLinesVisibility="Horizontal"
                             Style="{StaticResource DataGridStyle}"
                              MaxHeight="200"
                            RowStyle="{StaticResource DataGridRowStyle}"
                            SelectedItem="{x:Bind ViewModel.SelectedPurchaseOrder, Mode=TwoWay}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Mã ĐH" Binding="{Binding PurchaseOrderID}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier.SupplierName}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Nhân viên" Binding="{Binding Employee.EmployeeName}" Width="auto"/>
                                <controls:DataGridTemplateColumn Header="Ngày nhập" Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding OrderDate, Converter={StaticResource DateTimeConverter}, ConverterParameter='dd/MM/yyyy'}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Tổng tiền"  Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="auto"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </StackPanel>
                    <TextBlock Grid.Row="1" 
                           Text="Chi tiết đơn nhập hàng"  
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Foreground="#28344E"  
                           Margin="0,10,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <controls:DataGrid
                                x:Name="PurchaseOrderDetailsDataGrid"
                                ItemsSource="{x:Bind ViewModel.SelectedPurchaseOrderDetails, Mode=OneWay}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                GridLinesVisibility="Horizontal"
                                 Style="{StaticResource DataGridStyle}"
                                RowStyle="{StaticResource DataGridRowStyle}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Mã SP" Binding="{Binding Product.ProductName}" Width="auto"/>
                                <controls:DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="auto"/>
                                <controls:DataGridTemplateColumn Header="Đơn giá" Width="auto">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10" >
                        <TextBlock
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="#28344E"
                            VerticalAlignment="Center">
                                  <Run Text="Tổng chi nhập: "/>
                                  <Run Text="{x:Bind ViewModel.TotalPurchases, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal"  Spacing="10">
                            <Button Content="Trang trước"
                                    Command="{x:Bind ViewModel.PreviousPurchaseOrderPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPreviousPurchaseOrderPage, Mode=OneWay}" Style="{StaticResource ButtonStyle}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#28344E">
                                <Run Text="Trang "/>
                                <Run Text="{x:Bind ViewModel.PurchaseOrderCurrentPage, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind ViewModel.PurchaseOrderTotalPages, Mode=OneWay}"/>
                            </TextBlock>

                            <Button Content="Trang sau"
                                    Command="{x:Bind ViewModel.NextPurchaseOrderPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasNextPurchaseOrderPage, Mode=OneWay}"  Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </muxc:TabViewItem>
        </muxc:TabView>
    </Grid>
</Page>