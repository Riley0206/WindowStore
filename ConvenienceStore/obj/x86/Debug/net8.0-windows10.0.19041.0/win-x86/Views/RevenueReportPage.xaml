<Page
x:Class="ConvenienceStore.Views.RevenueReportPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="using:ConvenienceStore.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
mc:Ignorable="d"
Background="#F9F9F9">

    <Page.Resources>
        <!-- Button Style -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#41B4A3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="DataGridStyle" TargetType="toolkit:DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F0F0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- TextBlock Style for Labels -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#28344E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBlock Style for Values -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Header TextBlock Style -->
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Foreground" Value="#28344E"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Báo cáo doanh thu" 
             Style="{StaticResource HeaderTextBlockStyle}"
             Margin="0,0,0,20"/>

        <!-- Filter Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBlock Text="Khoảng thời gian:" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:ConnectionId='2' x:Name="TimeRangeComboBox" 
                Style="{StaticResource ComboBoxStyle}"
                SelectedItem="{Binding SelectedTimeRange, Mode=TwoWay}" 
                Width="150">
                <ComboBox.Items>
                    <x:String>Tháng</x:String>
                    <x:String>Năm</x:String>
                </ComboBox.Items>
            </ComboBox>

            <TextBlock Text="Năm:" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:ConnectionId='3' x:Name="YearComboBox" 
                Style="{StaticResource ComboBoxStyle}"
                SelectedValue="{Binding SelectedYear, Mode=TwoWay}" 
                Width="100">
                <ComboBox.Items>
                    <x:Int32>2020</x:Int32>
                    <x:Int32>2021</x:Int32>
                    <x:Int32>2022</x:Int32>
                    <x:Int32>2023</x:Int32>
                    <x:Int32>2024</x:Int32>
                    <x:Int32>2025</x:Int32>
                </ComboBox.Items>
            </ComboBox>

            <TextBlock Text="Tháng:" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:ConnectionId='4' x:Name="MonthComboBox" 
                Style="{StaticResource ComboBoxStyle}"
                SelectedValue="{Binding SelectedMonth, Mode=TwoWay}" 
                Width="100">
                <ComboBox.Items>
                    <x:Int32>1</x:Int32>
                    <x:Int32>2</x:Int32>
                    <x:Int32>3</x:Int32>
                    <x:Int32>4</x:Int32>
                    <x:Int32>5</x:Int32>
                    <x:Int32>6</x:Int32>
                    <x:Int32>7</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>9</x:Int32>
                    <x:Int32>10</x:Int32>
                    <x:Int32>11</x:Int32>
                    <x:Int32>12</x:Int32>
                </ComboBox.Items>
            </ComboBox>

            <Button Content="Lọc" 
                Style="{StaticResource ButtonStyle}"
                Command="{Binding UpdateFilteredTransactionsCommand}"/>

            <TextBlock Text="Đang tải..." 
                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Style="{StaticResource ValueStyle}"/>
        </StackPanel>

        <!-- Summary Cards -->
        <Grid Grid.Row="2" Margin="0,10,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Margin="5" CornerRadius="6" BorderBrush="#D4D4D4" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Doanh thu hiện tại" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding CurrentTimeRangeRevenue}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" Margin="5" CornerRadius="6" BorderBrush="#D4D4D4" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Doanh thu trước đó" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding PreviousTimeRangeRevenue}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" Margin="5" CornerRadius="6" BorderBrush="#D4D4D4" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Chi phí hiện tại" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding CurrentTimeRangeCost}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" Margin="5" CornerRadius="6" BorderBrush="#D4D4D4" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Chi phí trước đó" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding PreviousTimeRangeCost}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Transactions DataGrid -->
        <toolkit:DataGrid 
    Grid.Row="3" 
    Style="{StaticResource DataGridStyle}"
    ItemsSource="{Binding DisplayedTransactions}" 
    AutoGenerateColumns="False">
            <toolkit:DataGrid.Columns>
                <toolkit:DataGridTextColumn Header="ID" Binding="{Binding TransactionID}" IsReadOnly="True" Width="Auto"/>
                <toolkit:DataGridTextColumn Header="Loại" Binding="{Binding TransactionType}" IsReadOnly="True" Width="Auto"/>
                <toolkit:DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" IsReadOnly="True" Width="Auto"/>
                <toolkit:DataGridTextColumn Header="Ngày" Binding="{Binding TransactionDate, Converter={StaticResource DateTimeToStringConverter}}" IsReadOnly="True" Width="Auto"/>
                <toolkit:DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" IsReadOnly="True" Width="Auto"/>
                <toolkit:DataGridTextColumn Header="Phương thức thanh toán" Binding="{Binding PaymentMethod}" IsReadOnly="True" Width="*"/>
            </toolkit:DataGrid.Columns>
        </toolkit:DataGrid>

        <!-- Pagination -->
        <StackPanel Grid.Row="4" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                Margin="0,20,0,0" 
                Spacing="10">
            <Button Content="Trang trước" 
                Style="{StaticResource ButtonStyle}"
                Command="{Binding PreviousPageCommand}" 
                IsEnabled="{Binding HasPreviousPage}"/>

            <TextBlock Text="{Binding CurrentPage}" 
                 VerticalAlignment="Center" 
                 Style="{StaticResource ValueStyle}"/>

            <Button Content="Trang sau" 
                Style="{StaticResource ButtonStyle}"
                Command="{Binding NextPageCommand}" 
                IsEnabled="{Binding HasNextPage}"/>
        </StackPanel>
    </Grid>
</Page>

